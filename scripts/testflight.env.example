# Copy to scripts/testflight.env (git ignores it) and fill in your App Store Connect API key's IDs.
# App Store Connect → Users and Access → Integrations → App Store Connect API → Team Keys.
# The key file itself lives at ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8 (chmod 600).
ASC_KEY_ID=
ASC_ISSUER_ID=
